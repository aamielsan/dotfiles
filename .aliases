alias tmux='tmux -u new'
alias gtwork='cd ~/workspace/'
alias gtdnb='gtwork && cd dnb'
alias gtpersonal='gtwork && cd personal'
alias gtoss='gtwork && cd oss'
alias gtserverside='gtdnb && cd server-side'
alias gtssm='gtserverside && cd dnb-server-side'
alias gtweb='gtdnb && cd web'

function goreport() {
    git checkout $@ && go test -coverprofile=coverage-$@.out ./... && go tool cover -html coverage-$@.out -o cover-$@.html && zip test-report-$@.zip cover-$@.html coverage-$@.out
}

function buildgo() {
    ../scripts/package.py --sourcedir . --build-for-custom-runtime
}

alias bankingconf='yes | cp ~/.aws/config.banking ~/.aws/config'
alias nmbconf='yes | cp ~/.aws/config.nmb ~/.aws/config'
alias custconf='yes | cp ~/.aws/config.customer ~/.aws/config'
alias rdtconf='yes | cp ~/.aws/config.rdt ~/.aws/config'
alias pncconf='yes | cp ~/.aws/config.pnc ~/.aws/config'
alias rosdconf='yes | cp ~/.aws/config.rosd ~/.aws/config'
alias personalconf='yes | cp ~/.aws/config.personal ~/.aws/config'
alias mmconf='yes | cp ~/.aws/config.mm ~/.aws/config'
alias chanconf='yes | cp ~/.aws/config.channels ~/.aws/config'

alias k='kubectl'
alias python=python3
function idea() {
    local target="${1:-.}"
    open -a "IntelliJ IDEA Ultimate" "$(realpath "$target")"
}

alias lightmode='kitty +kitten themes --reload-in=all Rosé Pine Dawn'
alias darkmode='kitty +kitten themes --reload-in=all Rosé Pine Moon'

alias awsso='aws sso login --profile sit'

function tmuxn() {
    SESSION_NAME="default"
    tmux has-session -t $SESSION_NAME 2>/dev/null

    if [ $? -eq 0 ]; then
        tmux attach-session -t $SESSION_NAME
    else
        tmux new-session -s $SESSION_NAME -d
        tmux attach-session -t $SESSION_NAME
    fi
}
