# Machine- or module-specific hosts (e.g. the mise `work` env adds config.d/work).
# Include must come before any Host block.
Include ~/.ssh/config.d/*

Host github.com
  IdentityFile ~/.ssh/github-personal

Host *
  AddKeysToAgent yes
  UseKeychain yes     # keep key passphrases in the macOS Keychain
  IdentitiesOnly yes  # only offer the key configured for the host
