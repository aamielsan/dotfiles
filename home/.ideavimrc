" IdeaVim: the Neovim config's options and keymaps, mapped to IntelliJ actions.
" Action IDs: :actionlist, or turn on "Track Action Ids" in IdeaVim's menu.
" <Action> mappings must use nmap/vmap: they don't work with noremap.

let mapleader = " "

set clipboard+=unnamedplus
set number relativenumber
set scrolloff=8 sidescrolloff=8
set hlsearch incsearch " on by default in Neovim, off in IdeaVim

" Neovim's built-in gc commenting and nvim-surround
set commentary
set surround

nnoremap Y y$
inoremap jj <Esc>
inoremap jk <Esc>
nnoremap j gj
nnoremap k gk
nnoremap <Esc> :nohlsearch<CR>
nnoremap <C-s> :w<CR>
inoremap <C-s> <Esc>:w<CR>
vnoremap <C-s> <Esc>:w<CR>

" Pickers, explorer and terminal (snacks.nvim in Neovim)
nmap <Leader>f <Action>(FindInPath)
nmap <Leader>p <Action>(GotoFile)
nmap <Leader>o <Action>(RecentFiles)
nmap <Leader>l <Action>(ActivateProjectToolWindow)
nmap <Leader>t <Action>(ActivateTerminalToolWindow)

" Format (conform.nvim's =)
nmap = <Action>(ReformatCode)
vmap = <Action>(ReformatCode)

" LSP keymaps
nmap K <Action>(QuickJavaDoc)
nmap gd <Action>(GotoDeclaration)
nmap gD <Action>(GotoDeclaration)
nmap gi <Action>(GotoImplementation)
nmap go <Action>(GotoTypeDeclaration)
nmap gr <Action>(ShowUsages)
nmap gs <Action>(ParameterInfo)
nmap gl <Action>(ShowErrorDescription)
nmap [d <Action>(GotoPreviousError)
nmap ]d <Action>(GotoNextError)
