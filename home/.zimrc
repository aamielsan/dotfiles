# Zim modules, in load order. zimfw reads this file; the shell doesn't source it.
# .zshrc reinstalls modules on the next shell start after this file changes.

zmodule environment # sane built-in zsh options
zmodule git         # git aliases (prefix set in .zshrc)
zmodule input       # correct bindings for Home, End, Delete, ...
zmodule utility     # colour for ls, grep and less
zmodule fzf         # Ctrl-R history, Ctrl-T files, Alt-C cd; needs fzf on PATH

# Prompt: asciiship and the modules it reads
zmodule duration-info
zmodule git-info
zmodule prompt-pwd
zmodule asciiship

# Completion: extra definitions first, then the module that runs compinit
zmodule zsh-users/zsh-completions --fpath src
zmodule completion

# These must load last, in this order
zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions
