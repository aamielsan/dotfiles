fullscreen = true
font-size = 15
theme = "dark:Rose Pine Moon,light:Rose Pine Dawn"
# Padding takes the nearest cell's colour, so tmux's status bar reaches the window edges.
window-padding-color = extend

# Attach to the "main" tmux session, creating it if needed. Login shell so
# .zprofile puts mise's tmux on PATH.
command = /bin/zsh -l -c "tmux new-session -A -s main"
