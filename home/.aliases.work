function goreport() {
    git checkout $@ && go test -coverprofile=coverage-$@.out ./... && go tool cover -html coverage-$@.out -o cover-$@.html && zip test-report-$@.zip cover-$@.html coverage-$@.out
}

function buildgo() {
    ../scripts/package.py --sourcedir . --build-for-custom-runtime
}

# AWS account sets: each alias points this shell's AWS CLI at one set's sit/uat/prod
# profiles. ~/.aws/config is empty, so nothing reaches an account until you pick a set.
alias bankingconf='export AWS_CONFIG_FILE=$HOME/.aws/config.banking'
alias nmbconf='export AWS_CONFIG_FILE=$HOME/.aws/config.nmb'
alias custconf='export AWS_CONFIG_FILE=$HOME/.aws/config.customer'
alias rdtconf='export AWS_CONFIG_FILE=$HOME/.aws/config.rdt'
alias pncconf='export AWS_CONFIG_FILE=$HOME/.aws/config.pnc'
alias rosdconf='export AWS_CONFIG_FILE=$HOME/.aws/config.rosd'
alias mmconf='export AWS_CONFIG_FILE=$HOME/.aws/config.mm'
alias chanconf='export AWS_CONFIG_FILE=$HOME/.aws/config.channels'

alias awsso='aws sso login --profile sit'
# Show the active account set on the right of the prompt (aws:banking), nothing before one is picked
RPS1='${AWS_CONFIG_FILE:+%F{yellow\}aws:${AWS_CONFIG_FILE:e}%f}'

# Open pull request <n> as a worktree on branch pr-<n>, for review; the PR's own head is kept
# as pr/<n>. (wma --pr can't read DNB's dnb@ SSH remotes.) A bad number fails the fetch.
wmpr() { git fetch --no-prune upstream "+pull/$1/head:refs/remotes/pr/$1" && git branch "pr-$1" "pr/$1" && workmux add "pr-$1" }
# Inside a wmpr worktree: move pr-<n> to the PR's latest version, force-pushes included.
# Your own commits are replayed on top (pr/<n>'s reflog finds where they start), and
# uncommitted edits are stashed and put back.
wmpru() {
  local b=$(git branch --show-current) base
  [[ $b == pr-<-> ]] || { print -u2 "wmpru: not on a pr-<n> branch"; return 1 }
  git fetch --no-prune upstream "+pull/${b#pr-}/head:refs/remotes/pr/${b#pr-}" || return
  base=$(git merge-base --fork-point "pr/${b#pr-}") ||
    { print -u2 "wmpru: pr/${b#pr-} has no record of where $b started; nothing changed"; return 1 }
  git rebase --autostash --onto "pr/${b#pr-}" $base
}
