function goreport() {
    git checkout $@ && go test -coverprofile=coverage-$@.out ./... && go tool cover -html coverage-$@.out -o cover-$@.html && zip test-report-$@.zip cover-$@.html coverage-$@.out
}

function buildgo() {
    ../scripts/package.py --sourcedir . --build-for-custom-runtime
}

# AWS account sets: each alias points this shell's AWS CLI at one set's sit/uat/prod
# profiles. ~/.aws/config is empty, so nothing reaches an account until you pick a set.
alias bankingconf='export AWS_CONFIG_FILE=$HOME/.aws/config.banking'
alias nmbconf='export AWS_CONFIG_FILE=$HOME/.aws/config.nmb'
alias custconf='export AWS_CONFIG_FILE=$HOME/.aws/config.customer'
alias rdtconf='export AWS_CONFIG_FILE=$HOME/.aws/config.rdt'
alias pncconf='export AWS_CONFIG_FILE=$HOME/.aws/config.pnc'
alias rosdconf='export AWS_CONFIG_FILE=$HOME/.aws/config.rosd'
alias mmconf='export AWS_CONFIG_FILE=$HOME/.aws/config.mm'
alias chanconf='export AWS_CONFIG_FILE=$HOME/.aws/config.channels'

alias awsso='aws sso login --profile sit'
